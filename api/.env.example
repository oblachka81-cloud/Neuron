# ═══════════════════════════════════════════════════════════════
# NEURON VPN API — Environment Variables (ШАБЛОН)
# ═══════════════════════════════════════════════════════════════
# 
# ВАЖНО: этот файл — ШАБЛОН для репозитория.
# Реальные значения кладутся в `.env` — вручную на сервере.
# `.env` НЕ коммитится (уже в .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Сервер ──
PORT=3000
NODE_ENV=production

# ── MySQL (БД neuron) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=neuron
DB_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ
DB_NAME=neuron

# ── JWT (для токенов юзеров сайта) ──
# Сгенерируй случайную длинную строку — например:
#   openssl rand -hex 32
JWT_SECRET=ЗАМЕНИ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ
JWT_EXPIRES_IN=7d

# ── Marzban (панель VPN) ──
MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=NeuronVpn2026!

# ── VPN-сервер (для сборки VLESS-ссылки) ──
VPN_DOMAIN=neuron1.dpdns.org
VPN_WS_PATH=/ws-5f847e4871c4f2cb

# ── Лимиты для новых юзеров ──
DEFAULT_TRAFFIC_GB=10
DEFAULT_EXPIRE_DAYS=7

# ── CORS (для сайта) ──
ALLOWED_ORIGIN=https://neuron1.dpdns.org
